{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/server.ts",
    "src/scan-pool.ts",
    "src/scan-worker.ts"
  ]
}
